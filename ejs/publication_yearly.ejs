<style>
  ul.no-bullets {
    list-style-type: none;
    margin: 0;
    padding: 0;
  }

  .year-heading {
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    font-weight: bold;
    font-size: 1.2rem;
    padding-bottom: 0rem;
  }

  .author-name {
    font-weight: bold;
  }
</style>

<% let currentYear=null; let sortedItems=items.slice().sort((a, b)=> {
  let yearA = String(a.year || 'Unknown');
  let yearB = String(b.year || 'Unknown');

  // Handle "In Review" items - they should appear first
  let isReviewA = yearA.toLowerCase() === 'in review';
  let isReviewB = yearB.toLowerCase() === 'in review';

  if (isReviewA && !isReviewB) return -1;
  if (!isReviewA && isReviewB) return 1;
  if (isReviewA && isReviewB) return 0;

  // For numeric years, sort in descending order
  let numA = parseInt(yearA);
  let numB = parseInt(yearB);

  if (!isNaN(numA) && !isNaN(numB)) {
  return numB - numA;
  }

  // Handle non-numeric, non-review years
  if (isNaN(numA) && !isNaN(numB)) return 1;
  if (!isNaN(numA) && isNaN(numB)) return -1;

  // Both non-numeric: alphabetical
  return yearA.localeCompare(yearB);
  });
  %>
  <% for (let i=0; i < sortedItems.length; i++) { let item=sortedItems[i]; let itemYear=item.year || 'Unknown' ; if
    (currentYear !==itemYear) { if (currentYear !==null) { %>
    </ul>
